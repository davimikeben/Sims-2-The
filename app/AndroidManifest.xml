<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sims2.bundle"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Só para gravar o jogo extraído em Download/Sims2 (Android 11+). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- O emulador (com.armsx2) precisa estar instalado; declaramos a consulta
         para o getLaunchIntentForPackage funcionar no Android 11+. -->
    <queries>
        <package android:name="com.armsx2" />
    </queries>

    <application
        android:label="Sims 2 Mobile (Bundle)"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
